{
  "entities": {
    "AnalysisResult": {
      "title": "Analysis Result",
      "description": "A saved design comparison analysis.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "designImage": { "type": "string", "description": "Base64 or URL of design image" },
        "buildImage": { "type": "string", "description": "Base64 or URL of build image" },
        "marks": { "type": "array", "items": { "type": "object" } },
        "differences": { "type": "array", "items": { "type": "object" } },
        "url": { "type": "string" },
        "figmaUrl": { "type": "string" },
        "opacity": { "type": "number" },
        "scale": { "type": "number" },
        "position": { "type": "object" },
        "timestamp": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["designImage", "buildImage", "timestamp", "userId"]
    },
    "Project": {
      "title": "Project",
      "description": "A design checker project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "thumbnail": { "type": "string" },
        "updatedAt": { "type": "number" },
        "userId": { "type": "string" },
        "category": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "isStarred": { "type": "boolean" },
        "analysisData": { "type": "object", "description": "Latest analysis state" }
      },
      "required": ["name", "userId", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "A project category.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "userId", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "role": { "type": "string", "description": "e.g., Designer, Frontend Developer" },
        "updatedAt": { "type": "number" }
      },
      "required": ["displayName", "role", "updatedAt"]
    }
  },
  "firestore": {
    "/analysisResults/{resultId}": {
      "schema": "AnalysisResult",
      "description": "Collection of saved analysis results."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of design checker projects."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of project categories."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles."
    }
  }
}
