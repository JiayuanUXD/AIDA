# ============================================================
# 服务配置
# ============================================================
PORT=3000
NODE_ENV=production
DATA_DIR_NAME=data

# ============================================================
# AI 模型配置（仅在服务端使用，切勿暴露给前端）
# ============================================================
GEMINI_API_KEY=your-gemini-api-key
APIYI_API_KEY=your-apiyi-api-key
APIYI_MODEL_ID=kimi-k2.5

# ============================================================
# Figma 配置（仅在服务端使用）
# ============================================================
FIGMA_ACCESS_TOKEN=your-figma-access-token

# ============================================================
# 对象存储配置（二选一）
# 配置后将启用云存储，否则使用本地 data/ 目录
# ============================================================

# -- 方案 A：阿里云 OSS --
# OSS_REGION=oss-cn-hangzhou
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_BUCKET=your-bucket-name

# -- 方案 B：火山引擎 TOS（推荐，与火山引擎 ECS/VCI 同地域，内网传输免流量费）--
# 使用 TOS 时仍填写上方 OSS_* 变量，但 Endpoint 需改为 TOS 地址：
# OSS_REGION=tos-cn-beijing
# OSS_ACCESS_KEY_ID=your-volcengine-ak
# OSS_ACCESS_KEY_SECRET=your-volcengine-sk
# OSS_BUCKET=your-tos-bucket-name

# ============================================================
# 开发环境专用（生产环境无需设置）
# ============================================================
# DISABLE_HMR=true
