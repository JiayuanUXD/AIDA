# 阿里云 OSS 配置
OSS_REGION=your-oss-region (例如: oss-cn-hangzhou)
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=your-bucket-name

# 火山引擎部署配置
# 火山引擎环境变量（可选，根据实际部署环境调整）
# VOLCENGINE_REGION=cn-beijing
# VOLCENGINE_INSTANCE_ID=your-instance-id

# 其他配置
PORT=3000
DATA_DIR_NAME=data
NODE_ENV=production

# AI 模型配置
GEMINI_API_KEY=your-gemini-api-key
APIYI_API_KEY=your-apiyi-api-key
APIYI_MODEL_ID=kimi-k2.5

# Figma 配置
FIGMA_ACCESS_TOKEN=your-figma-access-token

# 部署环境配置
# 生产环境建议设置
# NODE_ENV=production
# 开发环境建议设置
# NODE_ENV=development
# DISABLE_HMR=true (在生产环境中禁用热重载)