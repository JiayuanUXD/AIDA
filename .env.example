# 数据库与存储路径
PORT=3000
# DATA_DIR_NAME 支持绝对路径（如 /mnt/storage），默认为项目根目录下的 data 目录
DATA_DIR_NAME=data
NODE_ENV=development

# 访问口令：设置后远程访问需先登录；不设置时仅本机回环地址可直接访问（远程 403）
ACCESS_PASSWORD=

# AI 模型配置：任意 OpenAI 兼容的多模态（视觉）模型
# 也可以启动后在「设置 · 模型」页面可视化添加模型（优先级高于环境变量）
# 默认按火山引擎 Ark 填写；OpenAI / Qwen 兼容模式 / OpenRouter 等只需替换 base URL 与模型 ID
AI_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_API_KEY=your-api-key
AI_MODEL=your-vision-model-id

# 多模型选择：可选。配置后分析栏出现模型下拉，可按次切换；每项可独立指定供应商
# 未填写的 baseUrl / apiKey 继承上面的 AI_API_BASE_URL / AI_API_KEY
# 设置页添加的自定义模型优先于这里的环境变量模型
# AI_MODELS=[{"id":"doubao","label":"豆包 Vision","baseUrl":"https://ark.cn-beijing.volces.com/api/v3","apiKey":"your-ark-key","model":"doubao-vision"},{"id":"gpt-4o","label":"GPT-4o","baseUrl":"https://api.openai.com/v1","apiKey":"sk-xxx","model":"gpt-4o"}]

# 兼容旧配置：AI_API_KEY / AI_MODEL 未设置时回退使用
# ARK_API_KEY=your-ark-api-key
# DOUBAO_MODEL_ID=your-doubao-model-id

# Figma 配置
FIGMA_ACCESS_TOKEN=your-figma-access-token

# 云存储（仅 Vercel 部署需要）
BLOB_READ_WRITE_TOKEN=

# 其他配置
DISABLE_HMR=false
