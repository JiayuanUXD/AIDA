# 火山引擎 TOS 对象存储配置
TOS_REGION=cn-beijing
TOS_ACCESS_KEY=your-tos-access-key
TOS_SECRET_KEY=your-tos-secret-key
TOS_BUCKET=your-tos-bucket-name
TOS_ENDPOINT=https://tos-cn-beijing.volces.com

# 其他配置
PORT=3000
# DATA_DIR_NAME 支持绝对路径（如 /mnt/tos）用于挂载存储
DATA_DIR_NAME=data
NODE_ENV=production

# AI 模型配置
GEMINI_API_KEY=your-gemini-api-key
APIYI_API_KEY=your-apiyi-api-key
APIYI_MODEL_ID=kimi-k2.5

# Figma 配置
FIGMA_ACCESS_TOKEN=your-figma-access-token

# 部署环境配置
# 生产环境建议设置
# NODE_ENV=production
# 开发环境建议设置
# NODE_ENV=development
# DISABLE_HMR=true (在生产环境中禁用热重载)