{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx api/index.ts",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "build:all": "npm run build && npm run build:server",
    "prestart": "npm run build:all",
    "start": "NODE_ENV=production node dist-server/api/index.js",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "typecheck": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "lint": "npm run typecheck && eslint src api tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@vercel/blob": "^2.3.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.35.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.2.0",
    "vitest": "^5.1.0"
  }
}
